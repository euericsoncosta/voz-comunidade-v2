# === Servidor ===
PORT=3000
NODE_ENV=development

# URL pública do backend (usada nos links dos e-mails de verificação e reset de senha).
# Em dev, http://localhost:3000. Em produção, https://seu-dominio.
# No Render pode ficar de fora: a API usa RENDER_EXTERNAL_URL (definida pelo Render) e
# ignora um APP_BASE_URL que aponte para localhost.
APP_BASE_URL=http://localhost:3000

# === Banco de Dados (MySQL/MariaDB) ===
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=voz_comunidade

# === JWT ===
# IMPORTANTE: gere um valor aleatório longo em produção.
# Linux/Mac:  openssl rand -hex 64
# Windows PS: [Convert]::ToBase64String((1..64 | %{Get-Random -Max 256}))
JWT_SECRET=troque-isto-por-uma-string-aleatoria-longa
JWT_EXPIRES_IN=30d

# === Cloudinary (moderação AWS Rekognition) ===
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rostos nas fotos dos relatos (detecção do Cloudinary):
# - um rosto que ocupe mais que esta fração da foto (0.08 = 8%) é tratado como selfie
#   e o relato é recusado; 0 desliga a recusa.
# - rostos menores (gente ao fundo) passam, mas desfocados; FACE_BLUR=false desliga o desfoque.
FACE_MAX_AREA_RATIO=0.08
FACE_BLUR=true

# === SMTP (envio de e-mails de verificação) ===
# Para Gmail:
#   1. Ative 2FA em https://myaccount.google.com/security
#   2. Gere uma "Senha de app" em https://myaccount.google.com/apppasswords
#   3. Cole a senha de 16 caracteres em SMTP_PASS (sem espaços)
# ATENÇÃO (Render): serviços gratuitos NÃO conseguem abrir conexões de saída nas
# portas 25, 465 e 587 — o Gmail (587) dá "Connection timeout" e nenhum e-mail sai.
# Em produção no Render use um provedor com SMTP na porta 2525, por exemplo Brevo:
#   SMTP_HOST=smtp-relay.brevo.com   SMTP_PORT=2525
#   SMTP_USER=<login SMTP da Brevo>  SMTP_PASS=<chave SMTP da Brevo>
#   SMTP_FROM="Voz da Comunidade <remetente-verificado@...>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=
SMTP_FROM="Voz da Comunidade <seu-email@gmail.com>"

# === Redefinição de senha ===
# Validade do link enviado por e-mail, em minutos.
PASSWORD_RESET_TTL_MINUTES=60

# Rate limit dos pedidos em POST /forgot-password (contadores em memória).
# Por IP: no máximo RESET_LIMIT_IP_MAX pedidos a cada RESET_LIMIT_IP_WINDOW_MIN min.
RESET_LIMIT_IP_MAX=5
RESET_LIMIT_IP_WINDOW_MIN=15
# Por e-mail (vale para qualquer e-mail digitado, exista a conta ou não).
RESET_LIMIT_EMAIL_MAX=3
RESET_LIMIT_EMAIL_WINDOW_MIN=60

# === Proxy reverso ===
# Nº de proxies à frente do app, pro rate limit ver o IP real do cliente.
# Render/Heroku = 1. Em produção o padrão já é 1; "0" desliga. Em dev, deixe vazio.
# TRUST_PROXY=1

# === CORS ===
CORS_ORIGINS=*
